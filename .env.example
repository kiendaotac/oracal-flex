# ---------------------------------------------------------------------------
# a1launcher configuration — copy to .env and fill in.
# Every value here can also live in config.yaml (lowercase or uppercase keys).
# Precedence: real env vars > .env > config.yaml > built-in defaults.
# NEVER commit the real .env — it identifies your tenancy.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# Tenancy OCID or a compartment OCID (ocid1.tenancy... / ocid1.compartment...)
COMPARTMENT_ID=ocid1.tenancy.oc1..aaaaaaaaexamplexxxxxx
# Subnet the instance VNIC attaches to (ocid1.subnet...)
SUBNET_ID=ocid1.subnet.oc1.ap-singapore-1.aaaaaaaaexamplexxxxxx
# Image OCID — must be an aarch64 image (Ubuntu/Oracle Linux ARM build)
IMAGE_ID=ocid1.image.oc1.ap-singapore-1.aaaaaaaaexamplexxxxxx

# Path INSIDE the container when running with Docker.
SSH_PUBLIC_KEY_PATH=/keys/id_ed25519.pub
DISPLAY_NAME=a1-flex

# --- Shape (Always Free A1 budget: 4 OCPU / 24 GB total) --------------------
OCPUS=2
MEMORY_GB=12
BOOT_VOLUME_GB=50
SHAPE=VM.Standard.A1.Flex
ASSIGN_PUBLIC_IP=true

# Optional: restrict which ADs to try. Empty = discover and try all of them.
# Accepts full names or the suffix, comma separated. e.g. AD-1,AD-2
AVAILABILITY_DOMAINS=
# Optional: pin a fault domain, e.g. FAULT-DOMAIN-1. Empty = let OCI choose.
FAULT_DOMAIN=
# Optional: network security groups, comma separated OCIDs.
NSG_IDS=

# --- OCI credentials -------------------------------------------------------
# Path INSIDE the container when running with Docker.
OCI_CONFIG_FILE=/home/app/.oci/config
OCI_PROFILE=DEFAULT

# --- Retry behaviour -------------------------------------------------------
# Random sleep between full passes over all availability domains.
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=180
# Pause between individual ADs inside one pass.
AD_DELAY_SECONDS=10
# Extra backoff after a 429 / TooManyRequests response.
RATE_LIMIT_SLEEP_SECONDS=900
# 0 = retry forever.
MAX_ROUNDS=0

# --- Logging ---------------------------------------------------------------
LOG_FILE=/var/log/a1launcher/a1launcher.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# --- Telegram notification (optional) --------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
