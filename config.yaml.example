# a1launcher configuration — copy to config.yaml.
# Anything set in .env or as a real environment variable overrides this file.

# --- Required ---------------------------------------------------------------
compartment_id: "ocid1.tenancy.oc1..aaaaaaaaexamplexxxxxx"
subnet_id: "ocid1.subnet.oc1.ap-singapore-1.aaaaaaaaexamplexxxxxx"
image_id: "ocid1.image.oc1.ap-singapore-1.aaaaaaaaexamplexxxxxx"   # must be aarch64
ssh_public_key_path: "/keys/id_ed25519.pub"                        # path inside the container
display_name: "a1-flex"

# --- Shape (Always Free A1 budget: 4 OCPU / 24 GB total) --------------------
ocpus: 2
memory_gb: 12
boot_volume_gb: 50
shape: "VM.Standard.A1.Flex"
assign_public_ip: true

# Empty / omitted means: discover every AD and try them all.
availability_domains: []
# fault_domain: "FAULT-DOMAIN-1"
nsg_ids: []

# --- OCI credentials --------------------------------------------------------
oci_config_file: "/home/app/.oci/config"   # path inside the container
oci_profile: "DEFAULT"

# --- Retry behaviour --------------------------------------------------------
min_delay_seconds: 60
max_delay_seconds: 180
ad_delay_seconds: 10
rate_limit_sleep_seconds: 900
max_rounds: 0          # 0 = forever

# --- Logging ----------------------------------------------------------------
log_file: "/var/log/a1launcher/a1launcher.log"
log_level: "INFO"
log_max_bytes: 5242880
log_backup_count: 3

# --- Telegram notification (optional) ---------------------------------------
telegram_enabled: false
telegram_bot_token: ""
telegram_chat_id: ""
